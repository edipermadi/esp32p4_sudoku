// The screen saver and power saving: saver_cb() in ui_saver.c, bsp_power_save()
digraph saver {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.35, pad=0.2];
    node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EEF3FB", color="#5B7DB1", margin="0.15,0.05"];
    edge  [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.7];
    on    [shape=oval, fillcolor="#E3F2E1", color="#4A8A44", label="Screen on"];
    idle  [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="No touch for the\nscreen timeout?\n(checked each second)"];
    pause [label="Game paused (clock stops, board hidden, saved)\nLock screen put under the cover, if on\nBlack cover on the system layer"];
    clk   [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="Screen saver?\n(the lock button:\nalways Dark)"];
    analog[label="Analog clock (dim greys),\nhands each second, moved each minute,\nCPU at full speed"];
    pend  [label="Three double pendulums\n(blue, yellow, red),\nchaotic, trails coloured by speed,\nnew start every 2 minutes"];
    liss  [label="Lissajous (blue, yellow dot),\nturning figure and beam, 25 fps,\nnew ratio every 16 s"];
    boids [label="Boids (blue, green, yellow\nflocks; red hawks), fading trails, 25 fps,\nCPU at full speed"];
    attr  [label="Strange attractor,\ndrawn point by point for 2 minutes,\nthen cleared, the next,\nCPU at full speed"];
    rain  [label="Digital rain (a colour a column),\n20 steps a second,\nCPU at full speed"];
    dim   [label="Dim grey clock,\nmoved each minute,\nCPU at full speed"];
    life  [label="A cellular automaton on 120 x 120 dots\n(Game of Life, Brian's Brain, Langton's ant,\ncyclic spirals, rock paper scissors, excitable medium,\nDay & Night, Seeds, Maze, Star Wars, forest fire),\neach its own choice"];
    tap1  [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="A tap within\n\"Screen saver for\"?"];
    dark  [label="Dark: backlight off, panel asleep,\nCPU at 180 MHz"];
    tap2  [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="A tap?"];
    wake  [label="On press: full speed, panel awake, light on\nOn release: the cover goes\n(the waking tap presses nothing)"];
    lock  [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="Lock screen\non?"];
    unlock[label="Swipe or PIN"];

    on -> idle;
    idle -> on [label="no"];
    idle -> pause [label="yes"];
    pause -> clk;
    clk -> dim [label="Digital"];
    clk -> analog [label="Analog"];
    clk -> rain [label="Rain"];
    clk -> attr [label="Attractor"];
    clk -> boids [label="Boids"];
    clk -> liss [label="Lissajous"];
    clk -> pend [label="Pendulum"];
    clk -> life [label="an automaton"];
    clk -> dark [label="Dark"];
    dim -> tap1;
    analog -> tap1;
    rain -> tap1;
    attr -> tap1;
    boids -> tap1;
    liss -> tap1;
    pend -> tap1;
    life -> tap1;
    tap1 -> wake [label="yes"];
    tap1 -> dark [label="no: time is up\n(Never: keeps waiting)"];
    dark -> tap2;
    tap2 -> tap2 [label="no"];
    tap2 -> wake [label="yes"];
    wake -> lock;
    lock -> unlock [label="yes"];
    lock -> on [label="no"];
    unlock -> on;
}
