// Making a puzzle: sudoku_generate() in gen_make.c
digraph generate {
    graph [bgcolor="white", fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.35, pad=0.2];
    node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EEF3FB", color="#5B7DB1", margin="0.15,0.05"];
    edge  [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.7];
    start [shape=oval, fillcolor="#E3F2E1", color="#4A8A44", label="sudoku_generate(variant, level, seed)\n(task gen, core 0)"];
    att   [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="Attempts left?\n(60 Easy/Medium,\n200 Hard, 400 Expert)"];
    kind  [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="What kind\nof variant?"];
    fixed [label="Full grid on the variant's own board\n(search with a shuffled digit order)"];
    jig   [label="Jigsaw: a new region map every 4 attempts\n(gen_jigsaw_map), then a full grid on it"];
    clue  [label="A Classic full grid, then the variant's\nclues taken from it (cages, marks, lines,\noutside clues: gen_regions.c, gen_lines.c)"];
    dig   [label="dig(): remove cells in symmetric pairs\nwhile exactly one solution stays\n(Easy stops early; Medium/Hard undo removals\nthat need harder techniques)"];
    grade [label="Grade it like a person would"];
    best  [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="Closer to the level asked for\nthan the best so far?\n(easier side preferred)"];
    keep  [label="Keep it"];
    exact [shape=diamond, style=filled, fillcolor="#FFF4DC", color="#C48A1A", label="Exactly the\nlevel asked for?"];
    yield [label="sudoku_gen_yield(): a 1-tick delay every 100 ms\n(the 5 s watchdog on core 0)", fillcolor="#F2F2F2", color="#999999"];
    done  [shape=oval, fillcolor="#E3F2E1", color="#4A8A44", label="The kept puzzle\n(\"Couldn't make a Hard ... quickly; this one is Medium\")"];

    start -> att;
    att -> kind [label="yes"];
    att -> done [label="no"];
    kind -> fixed [label="fixed board"];
    kind -> jig [label="Jigsaw"];
    kind -> clue [label="with clues"];
    fixed -> dig; jig -> dig; clue -> dig;
    dig -> grade -> best;
    best -> keep [label="yes"];
    best -> att [label="no"];
    keep -> exact;
    exact -> done [label="yes"];
    exact -> att [label="no"];
    dig -> yield [style=dotted, arrowhead=none];
}
