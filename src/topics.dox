/**
 * @file topics.dox
 * @brief The documentation's topics: each screen's UI and core under a common one (Doxygen only, not
 *        built).
 */

/**
 * @defgroup topic_settings Settings
 * @brief Settings: the screen (@ref settings) and what it does on the board (@ref settings_core).
 */

/**
 * @defgroup topic_sysmon System monitor
 * @brief The system monitor: the screen (@ref ui_sysmon) and its numbers (@ref sysmon_core).
 */

/**
 * @defgroup topic_trophies Trophies
 * @brief Trophies: the screen (@ref ui_trophies) and its data (@ref trophies_core).
 */

/**
 * @defgroup topic_files Files
 * @brief Files: the screen (@ref ui_file) and its work on the microSD card (@ref files_core).
 */

/**
 * @defgroup topic_gameplays Gameplays and Replay
 * @brief Gameplays and Replay: the screens (@ref ui_replay) and their data, replay timeline and video
 *        export (@ref gameplays_core).
 */

/**
 * @defgroup topic_history History
 * @brief History: the screen (@ref ui_history) and its data (@ref history_core).
 */

/**
 * @defgroup topic_statistics Statistics
 * @brief Statistics: the screen (@ref ui_stats) and its data (@ref statistics_core).
 */

/**
 * @defgroup topic_puzzles Puzzles
 * @brief Puzzles: the screen (@ref ui_list), its data (@ref puzzles_core) and the collections it lists
 *        (@ref collections).
 */

/**
 * @defgroup topic_players Players
 * @brief Players: the screen and its avatar picker (@ref ui_players) and its data (@ref players_core).
 */

/**
 * @defgroup topic_lock Lock screen
 * @brief The lock screen: its screens (@ref ui_lock) and its PIN (@ref lock_core).
 */

/**
 * @defgroup topic_game Game
 * @brief Playing a puzzle: the game screen (@ref ui_game) and the puzzles it plays (@ref generator).
 */

/**
 * @defgroup ui_game Game screen
 * @ingroup topic_game
 * @brief The game screen and what opens it: the board, input, hints, the tools, New puzzle, the
 *        daily puzzle, Learn, Enter a puzzle. The files share ui_internal.h.
 */

/**
 * @defgroup media Media
 * @brief Pictures and videos: the viewer in Files, and MP4 files read and written (replay export).
 */

/**
 * @defgroup bsp Board support
 * @brief The Waveshare ESP32-P4-WIFI6-Touch-LCD-4B: the display, touch, backlight, speaker and
 *        microphones, the microSD slot, power off. bsp_board.h declares it all.
 */
